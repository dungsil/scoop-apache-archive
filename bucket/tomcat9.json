{
    "homepage": "https://tomcat.apache.org",
    "version": "9.0.121",
    "checkver": {
        "url": "https://www.apache.org/dist/tomcat/tomcat-9/?C=M;O=D",
        "re": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "extract_dir": "apache-tomcat-$version",
        "architecture": {
            "32bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-9/v$version/bin/apache-tomcat-$version-windows-x86.zip"
            },
            "64bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-9/v$version/bin/apache-tomcat-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha512"
        }
    },
    "extract_dir": "apache-tomcat-9.0.121",
    "bin": "bin\\catalina.bat",
    "env_set": {
        "CATALINA_HOME": "$dir",
        "CATALINA_BASE": "$dir"
    },
    "suggest": {
        "JRE": "java/openjdk"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-9/v9.0.121/bin/apache-tomcat-9.0.121-windows-x64.zip",
            "hash": "sha512:b6ec0b1d60352614959ab4a07596485ccfbc584773b3fdd27cffefee5797a64cef497ec224608b4496607cc3ca4f2e508fd8a515e7e4ccbe715045a1e92e21b0"
        },
        "32bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-9/v9.0.121/bin/apache-tomcat-9.0.121-windows-x86.zip",
            "hash": "sha512:d7b70b28c6b8bb0cebf3511c8dde397d7cfb3894fa64730a8bb41f11fb77c6b3313983a4393f95a6309f714f304c21eb7e3c8896e742be497bcae0862dd77ef6"
        }
    }
}
