{
    "homepage": "https://tomcat.apache.org",
    "version": "9.0.124",
    "checkver": {
        "url": "https://www.apache.org/dist/tomcat/tomcat-9/?C=M;O=D",
        "re": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "extract_dir": "apache-tomcat-$version",
        "architecture": {
            "32bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-9/v$version/bin/apache-tomcat-$version-windows-x86.zip"
            },
            "64bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-9/v$version/bin/apache-tomcat-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha512"
        }
    },
    "extract_dir": "apache-tomcat-9.0.124",
    "bin": "bin\\catalina.bat",
    "env_set": {
        "CATALINA_HOME": "$dir",
        "CATALINA_BASE": "$dir"
    },
    "suggest": {
        "JRE": "java/openjdk"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-9/v9.0.124/bin/apache-tomcat-9.0.124-windows-x64.zip",
            "hash": "sha512:d7d37e9e2da57cd5ce70cba2d5ea620d5703862dc6265391925d859d209451bcec9e9cfb294bef363bb940a545d6317b268075075c0fac6e7253a98468c609fc"
        },
        "32bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-9/v9.0.124/bin/apache-tomcat-9.0.124-windows-x86.zip",
            "hash": "sha512:513ddf75bc5cea714c306cb92f3872e2fd41780a339221e3ab110940c52f2ac989f7fdb38093db1208640105ba80276b642c2a83903a27853a83e7bd76760def"
        }
    }
}
