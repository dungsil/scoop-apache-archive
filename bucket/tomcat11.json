{
    "homepage": "https://tomcat.apache.org",
    "version": "11.0.29",
    "checkver": {
        "url": "https://www.apache.org/dist/tomcat/tomcat-11/?C=M;O=D",
        "re": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "extract_dir": "apache-tomcat-$version",
        "architecture": {
            "64bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-11/v$version/bin/apache-tomcat-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha512"
        }
    },
    "extract_dir": "apache-tomcat-11.0.29",
    "bin": "bin\\catalina.bat",
    "env_set": {
        "CATALINA_HOME": "$dir",
        "CATALINA_BASE": "$dir"
    },
    "suggest": {
        "JRE": "java/openjdk"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-11/v11.0.29/bin/apache-tomcat-11.0.29-windows-x64.zip",
            "hash": "sha512:8df8d90f4b8cd3e7e5c0c548fab93f99d6acce1ffd57e68ea5fa4840a02da91cb2970ca3d4c30f6c0253aaceb59dde6b85c3ba358478c67201867907ae37d73b"
        }
    }
}
