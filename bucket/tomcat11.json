{
    "homepage": "https://tomcat.apache.org",
    "version": "11.0.24",
    "checkver": {
        "url": "https://www.apache.org/dist/tomcat/tomcat-11/?C=M;O=D",
        "re": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "extract_dir": "apache-tomcat-$version",
        "architecture": {
            "64bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-11/v$version/bin/apache-tomcat-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha512"
        }
    },
    "extract_dir": "apache-tomcat-11.0.24",
    "bin": "bin\\catalina.bat",
    "env_set": {
        "CATALINA_HOME": "$dir",
        "CATALINA_BASE": "$dir"
    },
    "suggest": {
        "JRE": "java/openjdk"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-11/v11.0.24/bin/apache-tomcat-11.0.24-windows-x64.zip",
            "hash": "sha512:bdff4dc163441fdbfbab7a0504d374dc25079497959829f3d94fada11fafaae55e56a577240b961711f583e31a1f8aa993b0675d768581ee87d3aa09d17761e9"
        }
    }
}
