{
    "homepage": "https://tomcat.apache.org",
    "version": "11.0.27",
    "checkver": {
        "url": "https://www.apache.org/dist/tomcat/tomcat-11/?C=M;O=D",
        "re": "v(?<version>[\\d.]+)"
    },
    "autoupdate": {
        "extract_dir": "apache-tomcat-$version",
        "architecture": {
            "64bit": {
                "url": "https://www.apache.org/dist/tomcat/tomcat-11/v$version/bin/apache-tomcat-$version-windows-x64.zip"
            }
        },
        "hash": {
            "url": "$url.sha512"
        }
    },
    "extract_dir": "apache-tomcat-11.0.27",
    "bin": "bin\\catalina.bat",
    "env_set": {
        "CATALINA_HOME": "$dir",
        "CATALINA_BASE": "$dir"
    },
    "suggest": {
        "JRE": "java/openjdk"
    },
    "architecture": {
        "64bit": {
            "url": "https://www.apache.org/dist/tomcat/tomcat-11/v11.0.27/bin/apache-tomcat-11.0.27-windows-x64.zip",
            "hash": "sha512:4783f5968d27ea1234419f8ebc18941bb8fd977f7852510f8879537836bce80d55378d6b01a19f49adaeeda40bf95cbbe9dc95f939a859bc4bc79a01aadf29ae"
        }
    }
}
